#!/usr/bin/python3 -I
"""SubagentStop hook: a `worker` can't finish while its worktree's `.claude/verify.sh` is red.

Runs only for agent_type "worker" whose transcript starts with a DISPATCH/REATTACH briefing.
The script runs in a sibling container (`# verify-image: <ref>` in its first lines) with no
network and only the worktree mounted (its `.git` read-only), never in claude-code. Red → exit 2 (the worker carries
on with the output); red again on the retry → let it stop and say so. See the README "agent-verify".
"""
import hashlib
import json
import os
import re
import subprocess
import sys
import uuid

WORKSPACE = os.path.realpath(os.path.expanduser(os.environ.get("AGENT_VERIFY_WORKSPACE", "~/workspace")))
CACHE = os.environ.get("AGENT_VERIFY_CACHE", os.path.join(WORKSPACE, "_agent-team", "verify-cache"))
TIMEOUT = float(os.environ.get("AGENT_VERIFY_TIMEOUT", "240"))
PULL_TIMEOUT = 120                     # all budgets together stay under the 480 s hook timeout
# The loop's worktree naming, `<repo>--<branch with / as ->`; keeps other `_`-prefixed dirs out.
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]*--[A-Za-z0-9._-]+$")
# Nothing a worktree file can set may make the hook's own git run a program.
GIT_ENV = {"GIT_CONFIG_COUNT": "3", "GIT_CONFIG_KEY_0": "core.fsmonitor", "GIT_CONFIG_VALUE_0": "false",
           "GIT_CONFIG_KEY_1": "diff.external", "GIT_CONFIG_VALUE_1": "",
           "GIT_CONFIG_KEY_2": "core.hooksPath", "GIT_CONFIG_VALUE_2": "/dev/null"}
BRIEF_RE = re.compile(r"^(?:DISPATCH|REATTACH) key=\S+ .*?\bworktree=(\S+)", re.M)
IMAGE_RE = re.compile(r"^#\s*verify-image:\s*(\S+)\s*$", re.M)
# Fully qualified, so the registry is never a guess; optional tag and digest.
REF_RE = re.compile(r"^[a-z0-9.-]+\.[a-z]{2,}(:[0-9]+)?/[a-z0-9._/-]+(:[A-Za-z0-9._-]{1,128})?(@sha256:[0-9a-f]{64})?$")


def log(msg):
    print(f"agent-verify: {msg}", file=sys.stderr)


def worktree_from(transcript):
    """The worktree= of the first briefing in the subagent's transcript, or None."""
    try:
        with open(transcript, errors="replace") as f:
            for n, line in enumerate(f):
                if n > 50:
                    return None
                try:
                    msg = json.loads(line)
                except ValueError:
                    continue
                if msg.get("type") != "user":
                    continue
                content = (msg.get("message") or {}).get("content")
                if isinstance(content, list):
                    content = "\n".join(c.get("text", "") for c in content if isinstance(c, dict))
                m = BRIEF_RE.search(content or "")
                if m:
                    return m.group(1)
                return None                     # the briefing is the first user message or nothing
    except OSError:
        return None
    return None


def safe_worktree(path):
    """A `<repo>--<branch>` directory directly under the workspace with a sane `.git`, or None."""
    real = os.path.realpath(os.path.expanduser(path))
    if os.path.dirname(real) != WORKSPACE or not NAME_RE.match(os.path.basename(real)) or not os.path.isdir(real):
        return None
    dotgit = os.path.join(real, ".git")
    if os.path.islink(dotgit):
        return None
    if os.path.isfile(dotgit):
        # A linked worktree: gitdir must be <workspace>/<repo>/.git/worktrees/<name>, i.e. one git made.
        with open(dotgit, errors="replace") as f:
            line = f.read(4096).strip()
        if not line.startswith("gitdir: "):
            return None
        gitdir = os.path.realpath(os.path.join(real, line[8:]))
        parts = os.path.relpath(gitdir, WORKSPACE).split(os.sep)
        if len(parts) != 4 or parts[0].startswith(("_", ".")) or parts[1:3] != [".git", "worktrees"]:
            return None
    elif not os.path.isdir(dotgit):
        return None
    return real


def state_key(wt):
    env = dict(os.environ, **GIT_ENV)
    def git(*a, text=True):
        return subprocess.run(["git", "-C", wt, *a], capture_output=True, text=text, timeout=10, env=env).stdout
    h = hashlib.sha256()
    for part in (git("rev-parse", "HEAD"), git("status", "--porcelain=v1", "-uall"),
                 git("diff", "--no-ext-diff", "--no-textconv", "HEAD")):
        h.update(part.encode())
    for rel in git("ls-files", "-z", "--others", "--exclude-standard").split("\0"):
        p = os.path.join(wt, rel)
        if rel and os.path.isfile(p) and not os.path.islink(p):
            with open(p, "rb") as f:
                h.update(rel.encode() + b"\0" + hashlib.sha256(f.read(64 << 20)).digest())
    return h.hexdigest()


def cache_path(wt):
    return os.path.join(CACHE, hashlib.sha256(wt.encode()).hexdigest()[:32])


def run_verify(wt, image):
    try:
        if subprocess.run(["docker", "image", "inspect", image], capture_output=True, timeout=30).returncode != 0:
            p = subprocess.run(["docker", "pull", "-q", image], capture_output=True, text=True, timeout=PULL_TIMEOUT)
            if p.returncode != 0:
                return p.returncode, f"could not pull {image}: {p.stderr.strip()[-300:]}"
    except subprocess.TimeoutExpired:
        return None, f"pulling {image} took over {PULL_TIMEOUT}s; it will be cached for the next try"
    name = f"agent-verify-{uuid.uuid4().hex[:12]}"
    # .git mounted read-only on top, so verify.sh can't repoint it at a gitdir whose config runs a program.
    cmd = ["docker", "run", "--rm", "--name", name, "--network", "none", "--memory", "4g", "--pids-limit", "2048",
           "--mount", f"type=bind,src={wt},dst=/work",
           "--mount", f"type=bind,src={wt}/.git,dst=/work/.git,readonly",
           "-w", "/work", "--entrypoint", "sh", image, ".claude/verify.sh"]
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=TIMEOUT)
        return p.returncode, (p.stdout + p.stderr)
    except subprocess.TimeoutExpired:
        subprocess.run(["docker", "rm", "-f", name], capture_output=True, timeout=30)
        return None, f"verify.sh did not finish within {TIMEOUT:.0f}s"


def main():
    try:
        hook = json.load(sys.stdin)
    except ValueError:
        return 0
    if hook.get("hook_event_name") != "SubagentStop" or hook.get("agent_type") != "worker":
        return 0
    raw = worktree_from(hook.get("agent_transcript_path") or "")
    wt = raw and safe_worktree(raw)
    if not wt:
        return 0
    script = os.path.join(wt, ".claude", "verify.sh")
    if os.path.islink(script) or not os.path.isfile(script):
        return 0
    with open(script, errors="replace") as f:
        head = "".join(f.readline() for _ in range(5))
    m = IMAGE_RE.search(head)
    if not m or not REF_RE.match(m.group(1)):
        log(f"{script}: no valid '# verify-image: <registry>/<image>:<tag>' line in its first 5 lines; skipped")
        return 0
    key = state_key(wt)
    cp = cache_path(wt)
    try:
        with open(cp) as f:
            if f.read().strip() == key:
                return 0                        # this exact tree already passed
    except OSError:
        pass
    rc, out = run_verify(wt, m.group(1))
    tail = "\n".join(out.strip().splitlines()[-40:])
    if rc == 0:
        os.makedirs(CACHE, exist_ok=True)
        with open(cp, "w") as f:
            f.write(key)
        return 0
    if hook.get("stop_hook_active"):
        print(f"{wt}/.claude/verify.sh is still red (exit {rc}). Say so in your report to the monitor "
              f"(HEARTBEAT or BLOCKED), don't claim green.\n{tail}", file=sys.stderr)
        return 0
    print(f"{wt}/.claude/verify.sh failed (exit {rc}) — fix it before you stop. If you are stopping "
          f"BLOCKED or waiting for CI on purpose, say why in your SendMessage and stop again. If you sent "
          f"ready=1 already, retract it now with a HEARTBEAT on the same sha without it.\n{tail}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:  # a broken hook must never wedge a worker
        log(f"internal error: {e}")
        sys.exit(0)
